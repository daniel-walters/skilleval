{
  "name": "@danielwaltersdev/skilleval",
  "version": "0.1.1",
  "description": "TypeScript client for skilleval: run evals via the Go CLI and assert with typed expect matchers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "skilleval": "bin/skilleval.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build && npm test",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "build:platforms": "node scripts/build-platform-binaries.mjs",
    "sync:platforms": "node scripts/sync-platform-versions.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "tsx": "^4.19.3",
    "yaml": "^2.7.0"
  },
  "optionalDependencies": {
    "@danielwaltersdev/skilleval-darwin-arm64": "0.1.1",
    "@danielwaltersdev/skilleval-darwin-x64": "0.1.1",
    "@danielwaltersdev/skilleval-linux-arm64": "0.1.1",
    "@danielwaltersdev/skilleval-linux-x64": "0.1.1",
    "@danielwaltersdev/skilleval-win32-arm64": "0.1.1",
    "@danielwaltersdev/skilleval-win32-x64": "0.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "skilleval",
    "agent",
    "skills",
    "eval",
    "testing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daniel-walters/skilleval.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://github.com/daniel-walters/skilleval/tree/main/sdk/typescript#readme",
  "bugs": {
    "url": "https://github.com/daniel-walters/skilleval/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}

{
  "name": "skilleval",
  "version": "0.1.0",
  "description": "TypeScript client for skilleval: run evals via the Go CLI and assert with typed expect matchers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build && npm test",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "skilleval",
    "agent",
    "skills",
    "eval",
    "testing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daniel-walters/skilleval.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://github.com/daniel-walters/skilleval/tree/main/sdk/typescript#readme",
  "bugs": {
    "url": "https://github.com/daniel-walters/skilleval/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
